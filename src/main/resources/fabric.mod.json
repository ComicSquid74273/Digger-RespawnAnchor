{
  "schemaVersion": 1,
  "id": "digger-respawn-anchor",
  "version": "${version}",
  "name": "Digger Respawn Anchor",
  "description": "A configurable Meteor module for digging terrain with respawn anchors.",
  "authors": [
    "ComicSquid"
  ],
  "icon": "assets/digger-respawn-anchor/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.comicsquid.respawnanchor.DiggerRespawnAnchor"
    ]
  },
  "custom": {
    "meteor-client:color": "225,80,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
